        "\u0645\u0644\u06a9\u06cc \u0648 \u0639\u0627\u0644\u0645\u06cc \u0645\u0639\u0627\u0634\u06cc \u0645\u062d\u0631\u06a9\u0627\u062a": "\u0631\u0648\u067e\u06cc \u06a9\u06cc \u0645\u0639\u0645\u0648\u0644\u06cc \u0642\u062f\u0631 \u0645\u06cc\u06ba \u0627\u0636\u0627\u0641\u06c1\u060c \u0644\u06cc\u06a9\u0646 \u0633\u06cc\u06a9\u0679\u0631 \u067e\u0631 \u0645\u062d\u062f\u0648\u062f \u0627\u062b\u0631",
        "\u0633\u067e\u0644\u0627\u0626\u06cc \u0686\u06cc\u0646 \u0645\u06cc\u06ba \u0645\u0642\u0627\u0645 \u0627\u0648\u0631 \u0627\u0635\u0644 \u0631\u06a9\u0627\u0648\u0679": "not applicable",
        "\u062b\u0628\u0648\u062a \u0627\u0648\u0631 \u0627\u06af\u0644\u0627 \u0686\u06cc\u06a9": "\u0627\u06af\u0631 \u0648\u0627\u0644\u06cc\u0648\u0645 \u0627\u0686\u0627\u0646\u06a9 \u0628\u0691\u06be \u062c\u0627\u0626\u06d2 \u062a\u0648 \u0628\u0631\u06cc\u06a9 \u0622\u0624\u0679 \u0645\u0645\u06a9\u0646",
        "\u0645\u062e\u0627\u0644\u0641 \u062f\u0644\u06cc\u0644 \u0627\u0648\u0631 \u0641\u06cc\u0635\u0644\u06c1 \u0628\u062f\u0644\u0646\u06d2 \u06a9\u06cc \u0634\u0631\u0637": "\u0627\u06af\u0631 \u0645\u062b\u0628\u062a \u06a9\u0645\u067e\u0646\u06cc \u062e\u0628\u0631 \u0633\u0627\u0645\u0646\u06d2 \u0622\u0626\u06d2 \u062a\u0648 \u062a\u062c\u0632\u06cc\u06c1 \u0628\u062f\u0644 \u0633\u06a9\u062a\u0627 \u06c1\u06d2"
      },
      "ticker": "AVN"
    }
  ]
}