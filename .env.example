SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your-agent@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_RECIPIENT=you@example.com
# Current Gemini model; override if Google changes model availability.
GEMINI_MODEL=gemini-3.8-flash
# Optional AI backup when Gemini is unavailable.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Total trading capital in PKR; each BUY suggests 10% of it. Leave out to skip share counts.
TRADING_CAPITAL=500000
# Optional: push a summary to Telegram or Discord as well as email.
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage  plus TELEGRAM_CHAT_ID
# Discord:  https://discord.com/api/webhooks/<id>/<token>
WEBHOOK_URL=
TELEGRAM_CHAT_ID=
